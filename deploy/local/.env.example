# Created by scripts/pull-secrets.sh from Key Vault kv-em-dev-skljlmd6ey75m (or copy to .env, chmod 600,
# and fill in by hand). Never commit .env.

# The machine's Tailscale name. The app answers only this Host name and localhost (DNS rebinding protection).
TAILNET_HOST=

Eloverblik__RefreshToken=
Telegram__BotToken=
# Sensibo API key from home.sensibo.com/me/api (Key Vault secret Sensibo--ApiKey).
Sensibo__ApiKey=

# Default Telegram recipients until they are changed under Indstillinger.
# Telegram__ChatIds__0=

# Electricity prices and costs, including the hourly prices for today and tomorrow.
Pricing__Enabled=true
# A Telegram message about tomorrow's prices is sent when their average is this many percent from the latest
# days', or an hour costs this much or more (DKK/kWh incl. VAT). 0 turns either off.
# Pricing__NotifyDeviationPercent=25
# Pricing__NotifyHighPrice=4.00

# The heat pump (Sensibo): live state, controls, recorded history and frost/offline alarms.
# Everyone on the tailnet can control it, like every other setting of the app.
Sensibo__Enabled=true

# Read-only MCP tools on /mcp, open to everyone on the tailnet.
Mcp__Enabled=false
