# Copy to .env (chmod 600). Never commit .env.
# The values are in Key Vault kv-em-dev-skljlmd6ey75m:
#   az keyvault secret show --vault-name kv-em-dev-skljlmd6ey75m --name Eloverblik--RefreshToken --query value -o tsv

Eloverblik__RefreshToken=
Telegram__BotToken=

# Default Telegram recipients until they are changed under Indstillinger.
# Telegram__ChatIds__0=

# Electricity prices and costs.
Pricing__Enabled=true

# Read-only MCP tools on /mcp, open to everyone on the tailnet.
Mcp__Enabled=false
