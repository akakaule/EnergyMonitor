{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure.Core": "Warning",
      "Azure.Identity": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Uri": ""
  },
  "Auth": {
    "Mode": "Oidc",
    "Authority": "",
    "ClientId": "",
    "Users": []
  },
  "Eloverblik": {
    "BaseUrl": "https://api.eloverblik.dk/customerapi/api/",
    "RetryBaseDelaySeconds": 60,
    "MaxAttempts": 4
  },
  "Telegram": {
    "BaseUrl": "https://api.telegram.org",
    "ChatIds": []
  },
  "Sync": {
    "BackfillDays": 90,
    "RefetchDays": 7,
    "ChunkDays": 30
  },
  "Schedule": {
    "Enabled": true,
    "TimeZone": "Europe/Copenhagen",
    "SyncTimes": [ "08:00", "17:00" ],
    "ReportTime": "09:00"
  }
}
