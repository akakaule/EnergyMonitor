{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure.Core": "Warning",
      "Azure.Identity": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Uri": ""
  },
  "Auth": {
    "Mode": "Oidc",
    "Authority": "",
    "ClientId": "",
    "Users": []
  },
  "Eloverblik": {
    "BaseUrl": "https://api.eloverblik.dk/customerapi/api/",
    "RetryBaseDelaySeconds": 60,
    "MaxAttempts": 4
  },
  "Telegram": {
    "BaseUrl": "https://api.telegram.org",
    "ChatIds": []
  },
  "Sync": {
    "BackfillDays": 90,
    "RefetchDays": 7,
    "ChunkDays": 30
  },
  "Schedule": {
    "Enabled": true,
    "TimeZone": "Europe/Copenhagen",
    "SyncTimes": [
      "08:00",
      "17:00"
    ],
    "ReportTime": "09:00",
    "PriceSyncTime": "13:30"
  },
  "Pricing": {
    "Enabled": false,
    "BaseUrl": "https://api.energidataservice.dk/",
    "BackfillDays": 90,
    "WindowHours": 3,
    "NotifyDeviationPercent": 25,
    "NotifyHighPrice": 4.00
  },
  "Sensibo": {
    "Enabled": false,
    "BaseUrl": "https://home.sensibo.com/api/v2/",
    "IntervalMinutes": 15
  },
  "Mcp": {
    "Enabled": false,
    "Authority": "",
    "Audience": "",
    "Resource": "",
    "ReadScope": "energy.read"
  }
}
